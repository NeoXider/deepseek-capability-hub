{
  "name": "@neoxider/mcp-hub",
  "version": "0.5.0",
  "description": "A lazy MCP and skill capability broker for DeepSeek Harness and other MCP clients",
  "type": "module",
  "private": false,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/NeoXider/neoxider-mcp-hub.git"
  },
  "homepage": "https://github.com/NeoXider/neoxider-mcp-hub#readme",
  "bugs": "https://github.com/NeoXider/neoxider-mcp-hub/issues",
  "engines": {
    "node": ">=22.19"
  },
  "bin": {
    "capability-hub-mcp": "dist/src/server.js",
    "capability-hub-admin": "dist/src/admin.js",
    "capability-hub-client": "dist/src/client.js",
    "capability-hub-harness-smoke": "dist/src/harness-smoke.js"
  },
  "files": [
    "dist/src",
    "data/catalog.json",
    "data/skills",
    "examples",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "pnpm run build && node --test dist/test/*.test.js",
    "start": "node dist/src/server.js --catalog data/catalog.json --state data/state",
    "client": "node dist/src/client.js --catalog data/catalog.json --state data/state",
    "smoke:harness": "pnpm run build && node dist/src/harness-smoke.js",
    "smoke:harness:external": "pnpm run build && node dist/src/harness-smoke.js --external-playwright",
    "bench": "pnpm run build && node bench/measure.mjs",
    "proof": "pnpm run build && node bench/dynamic-proof.mjs",
    "bench:accuracy": "pnpm run build && node bench/accuracy.mjs",
    "bench:schemas": "node bench/capture-schemas.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.30.0",
    "zod": "4.1.12"
  },
  "devDependencies": {
    "@playwright/mcp": "0.0.79",
    "@types/node": "24.10.1",
    "gpt-tokenizer": "^4.0.0",
    "typescript": "5.9.3"
  }
}
